import pandas as pd
import numpy as np

data = {
    'Name': ['Riya', 'Samar', 'Vihan', 'Meera'],
    'Age': [19, np.nan, 27, 22]
}

df = pd.DataFrame(data)

df['Age'].fillna(df['Age'].mean(), inplace=True)

print("DataFrame after filling missing values:")
print(df)
